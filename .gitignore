@'
# --- Dependencies & Build Artifacts ---
node_modules/
/dist
/build
/.next
/out

# --- Environment Variables & Secrets ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local
*.pem
*.key

# --- Operating System Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDEs and Editors ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
'@ | Set-Content .gitignore
